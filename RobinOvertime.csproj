<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- SMAPI 4.x 基于 .NET 6 运行时 -->
    <TargetFramework>net6.0</TargetFramework>
    <AssemblyName>RobinOvertime</AssemblyName>
    <RootNamespace>RobinOvertime</RootNamespace>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <EnableModDeploy>false</EnableModDeploy>
    <EnableModZip>false</EnableModZip>
    <Version>1.0.0</Version>
    <GenerateAssemblyInfo>true</GenerateAssemblyInfo>
    <LangVersion>latest</LangVersion>
  </PropertyGroup>

  <!-- 编译完成后把运行所需文件复制到游戏 Mods\RobinOvertime（照 Backpack4thRow 已验证的部署模式） -->
  <Target Name="DeployModFiles" AfterTargets="Build">
    <Copy SourceFiles="$(TargetPath);$(ProjectDir)manifest.json" DestinationFolder="D:\steam\steamapps\common\Stardew Valley\Mods\RobinOvertime" SkipUnchangedFiles="true" />
    <Copy SourceFiles="$(ProjectDir)i18n\default.json;$(ProjectDir)i18n\zh.json" DestinationFolder="D:\steam\steamapps\common\Stardew Valley\Mods\RobinOvertime\i18n" SkipUnchangedFiles="true" />
  </Target>

  <ItemGroup>
    <PackageReference Include="Pathoschild.Stardew.ModBuildConfig" Version="4.4.0" />
    <!-- Harmony 补丁库（与 SMAPI 4.5 内置的 0Harmony.dll 2.2.2 对齐；运行时由 SMAPI 提供，不随 Mod 分发） -->
    <PackageReference Include="Lib.Harmony" Version="2.2.2" />
  </ItemGroup>

  <ItemGroup>
    <Reference Update="0Harmony">
      <Private>false</Private>
    </Reference>
  </ItemGroup>

</Project>
